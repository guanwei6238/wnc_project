# bench/sweep-inline.conf.example -- sourced by sweep-inline.sh (plain bash).
# cp sweep-inline.conf.example sweep-inline.conf && edit.

ENGINES=(none suricata snort3)        # none = kernel-bridge baseline (run once; RULES/THREADS ignored)
RULES=(none full)                     # rule variants (engines only)
THREADS=(1 2)                         # engine threads (suricata: per interface; snort3: -z)
IFA=eth1                              # Pi interface cabled to the client
IFB=eth2                              # Pi interface cabled to the server
REPEATS=5
LABEL=sweep

# Tests and their arguments, one entry per run: "TEST [args forwarded to inline.sh]".
TESTS=(
  "latency --duration 30"
  "tcp --duration 30 --streams 4"
  "udp --duration 30 --frame 1400 --rate 80"
  "http --object 100k --conns 50 --reqs 20000"
  "cps --target-cps 500"           # RFC 9411 profile: 5 s init + 30 s ramp + 300 s sustain, pass/fail criteria (crit_* metrics)
  # "cps --conns 500"             # legacy short burst, no phases/criteria
  "tls --duration 20 --conns 100"
  "ttfb --object 1m --count 200"
)

# Optional NDR/PDR search per frame size (udp test). Empty = skip. Done once per engine/rules/threads.
NDR_FRAMES=()                         # e.g. (64 512 1400)
NDR_DURATION=10
export RATE_MIN=5 RATE_MAX=100 RATE_RES=2     # Mbit/s (3B+ USB NIC: ~150 Mbit/s ceiling)
export PDR_LOSS=0.5 NDR_LOSS=0.01             # percent

# Client trigger: $TEST $SERVER_IP $ARGS are substituted by inline.sh
export CLIENT_HOST=client.local
# ControlMaster: consecutive runs reuse one ssh connection (inline.sh creates /run/bench-ssh); drop the -o options to disable
export CLIENT_CMD='ssh -o ControlMaster=auto -o ControlPath=/run/bench-ssh/%C -o ControlPersist=10m $CLIENT_HOST bench/client/run-client.sh $TEST $SERVER_IP $ARGS'
export SERVER_IP=10.10.0.3

OUT=inline.csv
LOGDIR=/run/bench-logs

# Cool-down between runs
COOLDOWN=30                           # seconds
TEMP_MAX=55                           # wait until vcgencmd temp (degC) is below this

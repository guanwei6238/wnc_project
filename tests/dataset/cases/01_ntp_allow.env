# 案例：正常 NTP request/response（IoT-23 Hakai-8-1，Zeek 標籤 Benign）
DESC="正常 NTP（Benign）"
PCAP="data/裁切小案例/01_正常NTP_2封包.pcap"
# 原始資料裡的位址 → 會被改寫成 lab 的 cli / srv
ORIG_CLIENT=192.168.100.113
ORIG_SERVER=81.2.254.224
# 抓包時只看這個案例的流量（改寫後的位址）
CAPTURE="udp port 123"
# 待驗證規則：命中條件 + 處置
RULE_MATCH="udp dport 123"
RULE_VERDICT=accept

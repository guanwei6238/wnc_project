# 案例：C&C 標籤下的 3 個 SYN（IoT-23 Hakai-8-1，Zeek 標籤 Malicious C&C，conn_state=S0）
# 注意：封包沒有 payload，規則只能用 IP/port 封鎖，不代表 gateway 能「辨識」C&C。
DESC="C&C 標籤 SYN（Malicious）"
PCAP="data/裁切小案例/02_CnC標籤_SYN_3封包.pcap"
ORIG_CLIENT=192.168.100.113
ORIG_SERVER=178.128.185.250
CAPTURE="tcp port 50"
RULE_MATCH="ip daddr 10.0.2.2 tcp dport 50"
RULE_VERDICT=drop
